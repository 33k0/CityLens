# Copy to .env.local (gitignored). The map, analytics and fairness panels need NONE of these.

# IBM Bob: the staff chat and the labeling pipeline
BOB_API_KEY=
BOB_API_KEY_BACKUP=            # optional: used if the main key is refused (invalid, expired, out of credit)
BOB_LICENSE_ACCEPTED=          # serverless hosts only (e.g. Vercel): set to true once you have accepted the Bob license
BOB_TOTAL_USD=50               # total spend cap across pipeline and chat
BOB_CHAT_DAILY_USD=10          # daily chat spend cap
BOB_BUDGET_USD=10              # cap for a labeling run (scripts/bob_label.py)
