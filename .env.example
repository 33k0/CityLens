# Copy to .env.local (gitignored). The static build needs NONE of these.
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=granite4.2:8b
OLLAMA_EMBED_MODEL=nomic-embed-text
# anthropic | ollama  (blank -> anthropic if ANTHROPIC_API_KEY is set, else ollama)
ASSISTANT_PROVIDER=
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
BOB_API_KEY=
BOB_MAX_RUNS=6
WATSONX_API_KEY=
WATSONX_PROJECT_ID=
# blank -> MapLibre + OSM tiles. Never a secret (VITE_ vars ship to the browser).
VITE_GOOGLE_MAPS_KEY=
