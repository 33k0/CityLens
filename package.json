{
  "name": "civic-voice-map",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "data": "bash scripts/data.sh",
    "data:offline": "bash scripts/data.sh --offline",
    "demo": "npm run data:offline && npm run dev",
    "demo:warm": "npm run data && npm run dev",
    "test": "vitest run --passWithNoTests && (test -x .venv/bin/python && .venv/bin/python -m pytest -q tests || python3 -m pytest -q tests)"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@turf/turf": "^7.4.0",
    "@types/d3": "^7.4.3",
    "d3": "^7.9.0",
    "maplibre-gl": "^6.15.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-map-gl": "^8.1.3",
    "tailwindcss": "^4.3.3",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5"
  }
}
